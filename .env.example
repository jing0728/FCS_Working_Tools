# Google Sheet Configuration
SHEET_ID=your_google_sheet_id_here
TRACKING_TAB=2026
IF_HISTORY_TAB=IF_history

# File Paths
IF_XLS_PATH=ItemFulfillments.xls
CREDENTIALS_FILE=credentials.json

# Column Names (must match your Sheet's row 3 headers exactly)
COL_ORDER_DATE=Order Date
COL_ACCT=ACCT#
COL_ZIP=ZIP CODE
COL_SO=SO#
COL_STATUS=Status
COL_NOTE=Note
COL_SHIPPED_DATE=normal shipped date
COL_SEND_DATE=SEND DATE
COL_QTY=QTY

# Consolidation Parameters
EXPIRY_DAYS=7
URGENT_DAYS=2
CONSOLIDATE_WINDOW=3
LARGE_QTY_THRESHOLD=300

# Accounts to exclude from consolidation (comma-separated)
EXCLUDE_ACCTS=5042
